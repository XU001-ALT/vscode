[Unit]
Description=Chat Data (FastAPI + React)
After=network.target

[Service]
Type=simple
# 按实际部署路径修改 WorkingDirectory 和 User
WorkingDirectory=/opt/chat-data-assistant
User=www-data
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/chat-data-assistant/venv/bin/python -m uvicorn api.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
